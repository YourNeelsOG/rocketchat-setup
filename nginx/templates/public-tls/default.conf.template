# Public deployment with a Let's Encrypt certificate.
#
# Rendered by the nginx image's own envsubst entrypoint. Only ${RC_*} names are
# substituted (NGINX_ENVSUBST_FILTER="^RC_"), so nginx variables such as $host
# and $remote_addr pass through untouched.


map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${RC_DOMAIN};

    # Kept after issuance so renewals can revalidate over HTTP-01.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # $host carries no port, so the configured HTTPS port has to be added back
        # or this redirects to 443 no matter where HTTPS is actually published.
        # RC_HTTPS_PORT_SUFFIX is empty when the port is 443.
        return 301 https://$host${RC_HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    # Since nginx 1.25.1 HTTP/2 is its own directive. The older
    # `listen 443 ssl http2;` form still parses but is deprecated.
    http2 on;
    server_name ${RC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${RC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RC_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${RC_DOMAIN}/chain.pem;
    include /etc/nginx/ssl-params.conf;

    # OCSP stapling: requires a CA-signed certificate with an OCSP responder.
    # Placed here rather than in ssl-params.conf because the local-tls template
    # uses a self-signed certificate that has no responder.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=30s;
    resolver_timeout 5s;

    # HSTS is set only here, in the configuration that runs after a real
    # certificate exists. Sending it from a deployment whose TLS is not yet
    # working pins browsers to HTTPS for a year against a server that cannot
    # serve it, and nothing on the server can undo that.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size ${RC_MAX_UPLOAD_SIZE};
    # Stream the upload straight through rather than staging the whole body on
    # the proxy's disk first.
    proxy_request_buffering off;
    proxy_connect_timeout 3600s;
    proxy_send_timeout    3600s;
    proxy_read_timeout    3600s;

    location / {
        proxy_pass http://rocketchat:3000;
        # WebSocket upgrade is required for Rocket.Chat realtime messaging.
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}
