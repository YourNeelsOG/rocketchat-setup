# Example configuration.
#
# You do not need to write this file by hand. scripts/configure.sh asks for
# each value, probes the host for conflicts, and generates the real .env with
# mode 600. This file exists to document what the generated one contains, and
# to be copied and edited when driving an unattended install:
#
#   cp .env.example answers.env
#   $EDITOR answers.env
#   sudo ./scripts/configure.sh --config answers.env --non-interactive
#
# Every value here also has a command-line flag. See:  scripts/configure.sh --help

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Namespaces the containers, volumes and network. Change it if this host
# already runs a compose project called "rocketchat".
COMPOSE_PROJECT_NAME=rocketchat

# Which services start. Set by configure.sh from the deployment mode:
#   public-tls    proxy,acme
#   local-tls     proxy
#   plain-http    proxy
#   behind-proxy  (empty)
COMPOSE_PROFILES=proxy,acme

# behind-proxy mode adds the overlay that publishes Rocket.Chat directly:
#   COMPOSE_FILE=compose.yml:compose.direct.yml
COMPOSE_FILE=compose.yml

# ---------------------------------------------------------------------------
# Deployment mode
#
#   public-tls    Public server with a real domain. Let's Encrypt issues and
#                 renews the certificate automatically. Needs a public IP, a
#                 DNS record already pointing here, and port 80 reachable from
#                 the internet for HTTP-01 validation.
#
#   local-tls     LAN or home server. A local CA and server certificate are
#                 generated here. The CA must be installed on every device, or
#                 the Rocket.Chat mobile apps will refuse to connect.
#
#   behind-proxy  You already run Caddy, Traefik, nginx or Nginx Proxy Manager.
#                 This stack starts no proxy and issues no certificate; it just
#                 publishes Rocket.Chat on a plain HTTP port for yours to
#                 forward to.
#
#   plain-http    No TLS at all. Credentials cross the network in cleartext.
#                 Isolated networks and testing only.
# ---------------------------------------------------------------------------

RC_MODE=public-tls
RC_DOMAIN=chat.example.com
RC_ROOT_URL=https://chat.example.com
RC_LE_EMAIL=admin@example.com

# 1 uses the Let's Encrypt staging endpoint. Staging certificates are rejected
# by browsers but do not count against the production rate limits, so this is
# how you rehearse an install without burning quota.
RC_LE_STAGING=0

# ---------------------------------------------------------------------------
# Published ports
#
# configure.sh probes each of these and refuses to continue if something else
# holds one. Non-standard ports are fine and are reflected in RC_ROOT_URL,
# except for public-tls: Let's Encrypt HTTP-01 validation always connects to
# port 80, so that one cannot be moved.
# ---------------------------------------------------------------------------

# configure.sh sets this per-mode. In behind-proxy mode it defaults to
# 127.0.0.1 (loopback) for security; 0.0.0.0 is the default for modes with
# their own TLS termination. Override with --bind-address.
RC_BIND_ADDRESS=0.0.0.0
RC_HTTP_PORT=80
RC_HTTPS_PORT=443

# behind-proxy only: the host port Rocket.Chat is published on.
RC_APP_PORT=3000

# Picked from the ranges no existing Docker network on this host occupies.
RC_NETWORK_SUBNET=172.28.0.0/24

# Appended to the HTTP-to-HTTPS redirect URL. Empty when HTTPS is on 443.
# Set automatically by configure.sh.
RC_HTTPS_PORT_SUFFIX=

# Empty on kernels below 6.19. See the mongodb service in compose.yml.
# Set automatically by configure.sh.
RC_GLIBC_TUNABLES=

# ---------------------------------------------------------------------------
# Storage
#
# RC_MONGO_PATH and RC_MINIO_PATH accept either a Docker named volume
# (the defaults below) or an absolute host path, for putting data on a
# specific disk. An absolute path is checked for a suitable filesystem:
# MongoDB on NTFS, exFAT or a network mount corrupts silently and is refused.
# ---------------------------------------------------------------------------

RC_DATA_DIR=/opt/rocketchat
RC_MONGO_PATH=mongodb_data
RC_MINIO_PATH=minio_data
RC_BACKUP_DIR=/opt/rocketchat/backups

# Upload ceiling in bytes, applied to both nginx and Rocket.Chat.
# 2 GiB. Read docs/LARGE-FILE-TESTING.md before raising it: Rocket.Chat has no
# resumable upload and buffers the file in the application process, so a large
# ceiling on a small-memory host is an out-of-memory risk, not just a slow
# transfer.
RC_MAX_UPLOAD_SIZE=2147483648

# ---------------------------------------------------------------------------
# Image versions
#
# Change RC_VERSION through scripts/upgrade.sh, which checks the target against
# Rocket.Chat's supported-versions feed and takes a backup first.
# ---------------------------------------------------------------------------

RC_VERSION=8.5.3
RC_MONGODB_VERSION=8.0-ubi8
RC_NATS_VERSION=2.11-alpine
RC_MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
RC_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
RC_NGINX_VERSION=1.30-alpine
RC_CERTBOT_VERSION=v5.8.0

# Optional. Leave empty for a community deployment.
RC_LICENSE=
RC_REG_TOKEN=

# ---------------------------------------------------------------------------
# Credentials
#
# Generated by scripts/generate-secrets.sh. The root pair administers MinIO and
# is never given to Rocket.Chat; the application pair is scoped to the uploads
# bucket alone. Placeholders shown here; never use these values.
# ---------------------------------------------------------------------------

RC_MINIO_ROOT_USER=<generated>
RC_MINIO_ROOT_PASSWORD=<generated>
RC_MINIO_ACCESS_KEY=<generated>
RC_MINIO_SECRET_KEY=<generated>
RC_MINIO_BUCKET=rocketchat-uploads

# ---------------------------------------------------------------------------
# Host integration
# ---------------------------------------------------------------------------

# ufw | firewalld | none. "none" leaves the firewall untouched, which is the
# right answer on a host whose rules are managed elsewhere.
RC_FIREWALL=none

# The port sshd actually listens on. An allow rule for it is added BEFORE the
# firewall is enabled. Getting this wrong locks you out of a remote machine.
RC_SSH_PORT=22

# cron | systemd | none. Schedules certificate renewal (twice daily) and the
# backup. With "none", nothing renews your certificate: run
# scripts/renew-cert.sh and scripts/backup.sh from whatever you already use.
RC_SCHEDULE=systemd
RC_BACKUP_TIME=03:00
RC_BACKUP_KEEP_DAILY=7
RC_BACKUP_KEEP_WEEKLY=4
