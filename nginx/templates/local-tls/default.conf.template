# Local or LAN deployment with a self-signed certificate.
#
# The certificate is generated by scripts/issue-cert.sh into ./certs and
# mounted at /etc/nginx/certs. There is no ACME challenge location here,
# because nothing external validates this name.
#
# The Rocket.Chat mobile applications reject certificates they cannot verify.
# Install ./certs/ca.crt on each device, or use behind-proxy mode with a proxy
# that already holds a trusted certificate.


map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${RC_DOMAIN};
    # $host carries no port, so the configured HTTPS port has to be added back
    # or this redirects to 443 no matter where HTTPS is actually published.
    # RC_HTTPS_PORT_SUFFIX is empty when the port is 443.
    return 301 https://$host${RC_HTTPS_PORT_SUFFIX}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${RC_DOMAIN};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    include /etc/nginx/ssl-params.conf;

    # No HSTS. Pinning a browser to HTTPS for a name backed by a self-signed
    # certificate makes the certificate warning unskippable and the site
    # unreachable, with no server-side way to reverse it.

    client_max_body_size ${RC_MAX_UPLOAD_SIZE};
    proxy_request_buffering off;
    proxy_connect_timeout 3600s;
    proxy_send_timeout    3600s;
    proxy_read_timeout    3600s;

    location / {
        proxy_pass http://rocketchat:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}
